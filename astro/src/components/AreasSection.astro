---
import { getCollection } from 'astro:content';
import { serviceAreas } from '../data/areas';

interface Props {
  /**
   * Optional background class. Default is transparent.
   * Use 'bg-[var(--light-gray)]' for grey background.
   */
  background?: string;
}

const { background = '' } = Astro.props;

// Map each service area name to its landing page, where one exists.
const areaPages = await getCollection('areas');
const pageFor = new Map<string, string>();
for (const page of areaPages) {
  for (const name of page.data.covers) pageFor.set(name, `/areas/${page.id}/`);
}
---

<section class:list={['py-16', background]}>
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-2xl font-bold text-slate-900 mb-4">Areas We Cover</h2>
    <p class="text-slate-600 mb-6">
      Based in Stirling (FK8), we regularly work across the surrounding Central Scotland area:
    </p>
    <ul class="grid gap-2 text-slate-700 sm:grid-cols-2 md:grid-cols-4">
      {serviceAreas.map(area => {
        const href = pageFor.get(area);
        return (
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[var(--accent-wood)]"></span>
            {href ? <a href={href} class="hover:text-[var(--accent-wood)] hover:underline">{area}</a> : area}
          </li>
        );
      })}
    </ul>
    <p class="mt-6 text-sm">
      <a href="/areas/" class="font-medium text-[var(--accent-wood)] hover:underline">See all the areas we cover</a>
    </p>
  </div>
</section>
